<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ie" model="ir.module.category">
        <field name="name">Import &amp; Export Control</field>
        <field name="description">Segregation of duties for import and export transactions.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_ie_officer" model="res.groups">
        <field name="name">Import/Export Officer</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
        <field name="comment">Creates orders and handles shipment steps. Cannot approve an order they created.</field>
    </record>
    <record id="group_ie_procurement" model="res.groups">
        <field name="name">Procurement</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
    </record>
    <record id="group_ie_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
    </record>
    <record id="group_ie_warehouse" model="res.groups">
        <field name="name">Warehouse</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
    </record>
    <record id="group_ie_quality" model="res.groups">
        <field name="name">Quality</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user')), (4, ref('quality.group_quality_user'))]"/>
    </record>
    <record id="group_ie_compliance" model="res.groups">
        <field name="name">Control &amp; Compliance</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ie_management" model="res.groups">
        <field name="name">Management</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
    </record>
    <record id="group_ie_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to orders and the audit trail.</field>
    </record>
    <record id="group_ie_admin" model="res.groups">
        <field name="name">Module Administrator</field>
        <field name="category_id" ref="module_category_ie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_manager'))]"/>
        <field name="comment">Configures masters and approval stages. This group does not grant transaction approval.</field>
    </record>

    <record id="rule_ie_import_company" model="ir.rule">
        <field name="name">Import order multi-company</field>
        <field name="model_id" ref="model_ie_import_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ie_procurement')), (4, ref('group_ie_finance')), (4, ref('group_ie_warehouse')), (4, ref('group_ie_quality')), (4, ref('group_ie_compliance')), (4, ref('group_ie_management')), (4, ref('group_ie_auditor')), (4, ref('group_ie_admin'))]"/>
    </record>
    <record id="rule_ie_import_officer" model="ir.rule">
        <field name="name">Import order officer department</field>
        <field name="model_id" ref="model_ie_import_order"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('department_id', '=', False), '|', ('department_id', '=', user.ie_department_id.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ie_officer'))]"/>
    </record>
    <record id="rule_ie_export_company" model="ir.rule">
        <field name="name">Export order multi-company</field>
        <field name="model_id" ref="model_ie_export_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ie_procurement')), (4, ref('group_ie_finance')), (4, ref('group_ie_warehouse')), (4, ref('group_ie_quality')), (4, ref('group_ie_compliance')), (4, ref('group_ie_management')), (4, ref('group_ie_auditor')), (4, ref('group_ie_admin'))]"/>
    </record>
    <record id="rule_ie_export_officer" model="ir.rule">
        <field name="name">Export order officer</field>
        <field name="model_id" ref="model_ie_export_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ie_officer'))]"/>
    </record>
    <record id="rule_ie_company_generic" model="ir.rule">
        <field name="name">IE documents multi-company</field>
        <field name="model_id" ref="model_ie_lc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_bank_reference_company" model="ir.rule">
        <field name="name">Bank reference multi-company</field>
        <field name="model_id" ref="model_ie_bank_reference"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_dollar_balance_company" model="ir.rule">
        <field name="name">Dollar balance multi-company</field>
        <field name="model_id" ref="model_ie_dollar_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_dollar_balance_line_company" model="ir.rule">
        <field name="name">Dollar balance line multi-company</field>
        <field name="model_id" ref="model_ie_dollar_balance_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_shipment_company" model="ir.rule">
        <field name="name">Shipment multi-company</field>
        <field name="model_id" ref="model_ie_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_customs_company" model="ir.rule">
        <field name="name">Customs multi-company</field>
        <field name="model_id" ref="model_ie_customs_clearance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_proceeds_company" model="ir.rule">
        <field name="name">Proceeds multi-company</field>
        <field name="model_id" ref="model_ie_export_proceeds"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_gate_company" model="ir.rule">
        <field name="name">Compliance gate multi-company</field>
        <field name="model_id" ref="model_ie_compliance_gate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_exception_company" model="ir.rule">
        <field name="name">Compliance exception multi-company</field>
        <field name="model_id" ref="model_ie_compliance_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_tx_exception_company" model="ir.rule">
        <field name="name">Transaction exception multi-company</field>
        <field name="model_id" ref="model_ie_transaction_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_audit_company" model="ir.rule">
        <field name="name">Audit log multi-company</field>
        <field name="model_id" ref="model_ie_audit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_kpi_company" model="ir.rule">
        <field name="name">KPI multi-company</field>
        <field name="model_id" ref="model_ie_compliance_kpi"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_business_unit_company" model="ir.rule">
        <field name="name">Business unit multi-company</field>
        <field name="model_id" ref="model_ie_business_unit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_department_company" model="ir.rule">
        <field name="name">Department multi-company</field>
        <field name="model_id" ref="model_ie_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_stage_company" model="ir.rule">
        <field name="name">Approval stage multi-company</field>
        <field name="model_id" ref="model_ie_approval_stage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_supplier_quote_company" model="ir.rule">
        <field name="name">Supplier quotation multi-company</field>
        <field name="model_id" ref="model_ie_supplier_quote"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_export_opportunity_company" model="ir.rule">
        <field name="name">Export opportunity multi-company</field>
        <field name="model_id" ref="model_ie_export_opportunity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ie_export_quota_company" model="ir.rule">
        <field name="name">Export quota multi-company</field>
        <field name="model_id" ref="model_ie_export_quota"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_approval_auditor_read" model="ir.rule">
        <field name="name">Auditor reads import/export approval requests</field>
        <field name="model_id" ref="approvals.model_approval_request"/>
        <field name="groups" eval="[(4, ref('group_ie_auditor'))]"/>
        <field name="domain_force">['|', ('ie_import_order_id', '!=', False), ('ie_export_order_id', '!=', False)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
