<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ie_audit_log_view_list" model="ir.ui.view">
        <field name="name">ie.audit.log.list</field>
        <field name="model">ie.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="res_name"/>
                <field name="old_state"/>
                <field name="new_state"/>
                <field name="detail"/>
            </list>
        </field>
    </record>
    <record id="ie_audit_log_view_form" model="ir.ui.view">
        <field name="name">ie.audit.log.form</field>
        <field name="model">ie.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="user_id"/>
                        <field name="action"/>
                        <field name="res_name"/>
                        <field name="res_id"/>
                        <field name="old_state"/>
                        <field name="new_state"/>
                        <field name="reason"/>
                        <field name="detail"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ie_audit_log_view_search" model="ir.ui.view">
        <field name="name">ie.audit.log.search</field>
        <field name="model">ie.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_name"/>
                <field name="user_id"/>
                <filter name="transitions" string="Transitions" domain="[('action', '=', 'transition')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ie_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">ie.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
