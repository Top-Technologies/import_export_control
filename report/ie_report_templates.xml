        <field name="model">ie.export.order.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_stock_balance_document</field>
        <field name="report_file">import_export_control.report_stock_balance_document</field>
        <field name="binding_model_id" ref="model_ie_export_order_line"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_lc" model="ir.actions.report">
        <field name="name">LC Status</field>
        <field name="model">ie.lc</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_lc_document</field>
        <field name="report_file">import_export_control.report_lc_document</field>
        <field name="binding_model_id" ref="model_ie_lc"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_shipment" model="ir.actions.report">
        <field name="name">Shipment Tracking</field>
        <field name="model">ie.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_shipment_document</field>
        <field name="report_file">import_export_control.report_shipment_document</field>
        <field name="binding_model_id" ref="model_ie_shipment"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_proceeds" model="ir.actions.report">
        <field name="name">Export Proceeds Reconciliation</field>
        <field name="model">ie.export.proceeds</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_proceeds_document</field>
        <field name="report_file">import_export_control.report_proceeds_document</field>
        <field name="binding_model_id" ref="model_ie_export_proceeds"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_landed" model="ir.actions.report">
        <field name="name">Landed Cost Summary</field>
        <field name="model">ie.import.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_landed_document</field>
        <field name="report_file">import_export_control.report_landed_document</field>
        <field name="binding_model_id" ref="model_ie_import_order"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_audit" model="ir.actions.report">
        <field name="name">Audit Trail</field>
        <field name="model">ie.audit.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_audit_document</field>
        <field name="report_file">import_export_control.report_audit_document</field>
        <field name="binding_model_id" ref="model_ie_audit_log"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_exception" model="ir.actions.report">
        <field name="name">Exception Register</field>
        <field name="model">ie.compliance.exception</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_exception_document</field>
        <field name="report_file">import_export_control.report_exception_document</field>
        <field name="binding_model_id" ref="model_ie_compliance_exception"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_review" model="ir.actions.report">
        <field name="name">90-day Post-Implementation Review</field>
        <field name="model">ie.compliance.kpi</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">import_export_control.report_review_document</field>
        <field name="report_file">import_export_control.report_review_document</field>
        <field name="binding_model_id" ref="model_ie_compliance_kpi"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
